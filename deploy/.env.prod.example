# Production environment for the VPS stack (ADR 0045). Copy to deploy/.env on
# the server, fill in real values, `chmod 600`. Never commit the filled file.
# Generate every secret with: openssl rand -hex 32

# --- Stack ---
API_DOMAIN=api.example.com
API_IMAGE=ghcr.io/inisialkey/antrein-api:latest

# --- Database (postgres is the compose service name) ---
POSTGRES_USER=antrein
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=antrein
DATABASE_URL=postgresql://antrein:CHANGE_ME@postgres:5432/antrein

# --- Auth (ADR 0011 TTLs, ADR 0039 hashing) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

# --- Files (ADR 0046). The root is a named volume mounted at /data/storage. ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/data/storage
# Must match API_DOMAIN — it is baked into every returned file URL.
PUBLIC_API_URL=https://api.example.com

# --- Payments (sandbox adapter is the only implemented provider) ---
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
PAYMENT_EXPIRATION_MINUTES=30

# --- Jobs (0 disables a timer; defaults match ADR 0040 cadences) ---
PAYMENT_EXPIRATION_JOB_INTERVAL_MS=60000
OUTBOX_DISPATCHER_INTERVAL_MS=2000
PAYMENT_RECONCILIATION_INTERVAL_MS=300000
CONSISTENCY_CHECK_INTERVAL_MS=86400000

# --- Email: any ESP SMTP relay (ADR 0045 closes ADR 0037) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=CHANGE_ME
SMTP_SECURE=false
EMAIL_FROM=AntreIn <no-reply@example.com>

# --- Push (ADR 0044) — 'log' until OneSignal credentials exist ---
PUSH_PROVIDER=log
# PUSH_PROVIDER=onesignal
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# --- Metrics: token required in production whenever enabled ---
METRICS_ENABLED=true
METRICS_TOKEN=CHANGE_ME

# --- Realtime fan-out: unset = in-memory, correct for one instance (ADR 0036) ---
# REDIS_URL=redis://redis:6379
