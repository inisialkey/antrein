# APP
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antrein

# REDIS
REDIS_URL=redis://localhost:6379

# AUTH (defaults ratified in docs/adr/0011-token-ttl-defaults.md)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
JWT_ACCESS_SECRET=dev-only-jwt-secret-3f5553520b7c6462608089304169bd8944827c11d597b16b

# STORAGE (ADR 0046 — local disk; the minio compose service is unused)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage
# Origin used to build public file URLs (§37.1)
PUBLIC_API_URL=http://localhost:3000

# PAYMENT
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=sandbox-webhook-secret
PAYMENT_EXPIRATION_MINUTES=30
PAYMENT_EXPIRATION_JOB_INTERVAL_MS=60000

# NOTIFICATION (ADR 0044 — 'log' until OneSignal credentials exist)
PUSH_PROVIDER=log
# PUSH_APP_ID / PUSH_API_KEY arrive with the real OneSignal adapter

# EMAIL (ADR 0037 — Mailpit locally; ESP relay in production, ADR 0045)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@antrein.local
# SMTP_USER / SMTP_PASSWORD / SMTP_SECURE stay unset locally — Mailpit takes no auth

# PROXY (ADR 0045 — 'true' only behind the Caddy reverse proxy)
TRUST_PROXY=false

# WORKER (ADR 0035)
WORKER_MODE=inline
