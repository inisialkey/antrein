  "info": {
    "title": "AntreIn API",
    "description": "Booking, payment, check-in, and real-time queue platform. Human-readable contract: docs/02-api-contract.md",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Oki"
          },
          "email": {
            "type": "string",
            "example": "oki@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+6281234567890"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "device_01J..."
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          },
          "appVersion": {
            "type": "string",
            "example": "1.0.0"
          },
          "deviceName": {
            "type": "string",
            "example": "Pixel 9"
          }
        },
        "required": [
          "deviceId",
          "platform"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "oki@example.com"
          },
          "password": {
            "type": "string"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "oki@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "formatted": {
            "type": "string",
            "example": "Jl. Example No. 10, Jakarta"
          },
          "latitude": {
            "type": "number",
            "example": -6.2
          },
          "longitude": {
            "type": "number",
            "example": 106.8
          }
        },
        "required": [
          "formatted"
        ]
      },
      "CreateOutletDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Main Outlet"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+622112345678"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          }
        },
        "required": [
          "name",
          "address"
        ]
      },
      "CreateBusinessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "AntreIn Barbershop"
          },
          "description": {
            "type": "string"
          },
          "logoFileId": {
            "type": "string",
            "example": "fil_01J..."
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Jakarta"
          },
          "primaryOutlet": {
            "$ref": "#/components/schemas/CreateOutletDto"
          }
        },
        "required": [
          "name",
          "primaryOutlet"
        ]
      },
      "BookingPolicyDto": {
        "type": "object",
        "properties": {
          "minimumLeadMinutes": {
            "type": "number",
            "example": 60
          },
          "maximumAdvanceDays": {
            "type": "number",
            "example": 30
          },
          "automaticConfirmation": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "DepositPolicyDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "defaultType": {
            "type": "string",
            "enum": [
              "none",
              "fixed"
            ]
          },
          "defaultValue": {
            "type": "number",
            "example": 10000
          }
        },
        "required": [
          "enabled"
        ]
      },
      "CancellationPolicyDto": {
        "type": "object",
        "properties": {
          "fullRefundBeforeMinutes": {
            "type": "number",
            "example": 360
          },
